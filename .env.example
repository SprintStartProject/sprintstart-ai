# LLM backends
# LLM_BACKEND drives chat/generate/stream/vision. EMBED_BACKEND (optional)
# routes embeddings to a separate provider. Options: ollama, openai/litellm,
# anthropic. Example split: chat on Anthropic, embeddings on an OpenAI-compatible
# LiteLLM endpoint -> LLM_BACKEND=anthropic, EMBED_BACKEND=openai
LLM_BACKEND=
EMBED_BACKEND=
CHROMA_PATH=
# Request timeout in seconds, applied to every backend. Defaults to 600 (what
# the Anthropic and OpenAI SDKs use); Ollama would otherwise wait forever, so a
# wedged daemon hangs the request instead of erroring. Set 0 to disable — only
# worth it for a long local batch.
LLM_TIMEOUT_SECONDS=


# --- Anthropic (Claude) ---
# Use LLM_BACKEND=anthropic. Anthropic has no embeddings API, so pair it with an
# EMBED_BACKEND that does. Claude is multimodal; ANTHROPIC_VISION_MODEL defaults
# to ANTHROPIC_CHAT_MODEL.
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-4-5
ANTHROPIC_VISION_MODEL=
ANTHROPIC_MAX_TOKENS=4096
# Opt-in reasoning budget for streamed chat answers. Anthropic requires at
# least 1024 and less than ANTHROPIC_MAX_TOKENS. Leave empty or set 0 to
# disable extended thinking for models that do not support it.
ANTHROPIC_THINKING_BUDGET_TOKENS=1024
# Optional override (e.g. a proxy). Defaults to https://api.anthropic.com
ANTHROPIC_BASE_URL=

# --- Ollama ---
# Local: http://localhost:11434
# Docker (Ollama on host machine): http://host.docker.internal:11434
# Remote: https://your-ollama-host
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
OLLAMA_VISION_MODEL=
# Context window. Leave empty for Ollama's default (~4096), which silently
# truncates large prompts and breaks onboarding synthesis. Set to your model's
# window, e.g. 32768.
OLLAMA_NUM_CTX=

# --- OpenAI-compatible (OpenAI / LiteLLM / proxy) ---
# Use LLM_BACKEND=openai or EMBED_BACKEND=openai.
# OpenAI: https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBED_MODEL=
OPENAI_VISION_MODEL=
# Optional output limit for streamed chat answers. When a reasoning budget is
# enabled, this value must be greater than OPENAI_REASONING_MAX_TOKENS.
OPENAI_MAX_TOKENS=
# Opt-in provider reasoning budget for streamed chat answers. OpenRouter maps
# this unified setting to supported Anthropic, OpenAI-compatible, and other
# reasoning models. Leave empty or set 0 for models without a reasoning channel.
OPENAI_REASONING_MAX_TOKENS=


# Set to 1 to log each agent's reasoning step (LLM text + tool calls) to stderr.
# AGENT_DEBUG=0

# --- chunk settings ---
CHUNK_SIZE=
CHUNK_OVERLAP=
# Character-count ceiling (proxy for a token limit — no tokenizer in this
# project) for text/PDF content sent to the LLM-based context-aware chunker
# (POST /api/v1/ingest, semantic_boundaries/contextualize flags). Above this,
# ingestion falls back to the plain chunk_text strategy. Leave empty for the
# default (24000).
CONTEXT_AWARE_CHUNKING_MAX_CHARS=
