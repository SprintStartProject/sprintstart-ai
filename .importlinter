# The layers of the AI service. Higher layers may import lower ones, never the other
# way round, and the features on one line are independent of each other. `ignore_imports` lists the
# violations that existed when this was introduced; it may only shrink (an entry that no longer
# matches fails the check). Run with `PYTHONPATH=src uv run lint-imports`.

[importlinter]
root_packages =
    api
    onboarding
    insights
    projects
    skills
    agents
    rag
    ingestion
    store
    llm

[importlinter:contract:layers]
name = Layers: api > features > agents > rag > ingestion > store > llm
type = layers
layers =
    api
    onboarding | insights | projects | skills
    agents
    rag
    ingestion
    store
    llm
ignore_imports =
    ingestion.mapper -> rag.filters
    ingestion.mapper -> rag.types
    ingestion.metadata_store -> rag.filters
    ingestion.source_state_store -> rag.source_filter
    projects.evaluation -> api.schemas
    skills.suggestion -> api.schemas
    store.base -> ingestion.source_role
    store.base -> rag.source_filter
    store.base -> rag.types
    store.chroma_store -> ingestion.metadata_store
    store.chroma_store -> ingestion.source_role
    store.chroma_store -> rag.filters
    store.chroma_store -> rag.source_filter
    store.chroma_store -> rag.types
